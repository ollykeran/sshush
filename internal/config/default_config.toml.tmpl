# Example config.toml
[agent]
socket_path = {{ printf "%q" .SocketPath }}
type = "keys"
# type options: "keys" (load key_paths into an in-memory keyring, default)
#               "vault" (use [vault].vault_path as the agent backend instead of key_paths)
#               "external" (socket_path points at a foreign ssh-agent/1Password/etc.; sshush never starts/stops it)
key_paths = {{ .KeyPathsTOML }}

# [vault]
# vault_path = "~/.config/sshush/vault.json"
#
# [server]
# listen_port = 2222
# authorized_keys = "~/.ssh/authorized_keys"
# host_key is optional: the server keeps one at ~/.config/sshush/server_host_ed25519,
# creating it on first start. Set this only to put it somewhere else.
# host_key = "~/.ssh/sshush_host_ed25519"
# shell is optional: sessions run the server daemon's $SHELL, falling back to
# /bin/bash and then /bin/sh. Set this to run something else.
# shell = "/bin/zsh"
# password_auth lets clients sign in with the vault's passphrase as well as a key.
# It needs [vault].vault_path, and checking a password never unlocks the agent.
# password_auth = true

[theme]
name = "default"
no_color = false
