# Example config.toml
[agent]
socket_path = {{ printf "%q" .SocketPath }}
type = "keys"
key_paths = {{ .KeyPathsTOML }}
# type = "vault"     # use [vault].vault_path as the agent backend instead of key_paths
# type = "external"  # socket_path points at a foreign ssh-agent/1Password/etc.; sshush never starts/stops it

