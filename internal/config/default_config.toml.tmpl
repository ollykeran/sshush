# Example config.toml
[agent]
socket_path = {{ printf "%q" .SocketPath }}
type = "keys"
# type options: "keys" (load key_paths into an in-memory keyring, default)
#               "vault" (use [vault].vault_path as the agent backend instead of key_paths)
#               "external" (socket_path points at a foreign ssh-agent/1Password/etc.; sshush never starts/stops it)
key_paths = {{ .KeyPathsTOML }}

