<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for sshush on Windows. scripts/msix.sh fills in the
  placeholders (see packaging/msix/README.md) and packs it with the binaries
  and Assets/.

  One application, Tray: sshush-tray.exe, the Start menu entry, with
  - the StartupTask that starts it at sign-in. A package cannot write the
    user's Run key (its registry writes go to a private copy), so this is how
    the tray starts with Windows. The task must belong to this application:
    Windows looks a task up by the application asking, and the tray's "Start
    at sign-in" checkbox switches it. A start by the task passes no
    arguments; the tray asks Windows how it was activated instead.
  - the "sshush" app execution alias, which runs sshush.exe from any shell.
    An extension can name its own executable, as Windows Terminal's wt.exe
    does, so the command line needs no application of its own: the Store
    refuses one hidden from Start (AppListEntry="none") without a waiver.
    sshushd.exe sits beside sshush.exe, where sshush looks for the daemon
    first.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>@DISPLAY_NAME@</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>OpenSSH compatible SSH agent with a tray, a TUI and an optional encrypted key vault.</Description>
  </Properties>

  <Dependencies>
    <!-- 19041: Windows 10 2004, the base every Windows 10 still updated (22H2) is built on. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Tray" Executable="sshush-tray.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="@DISPLAY_NAME@"
        Description="SSH agent and key manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="sshush-tray.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="SshushTray" Enabled="true" DisplayName="@DISPLAY_NAME@" />
        </desktop:Extension>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="sshush.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="sshush.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
