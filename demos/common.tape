# Shared VHS settings, included with `Source demos/common.tape` at the top
# of each demo's own .tape file. Keep this to cosmetics only — Output and
# actual keystrokes stay in the individual tape files.
Set Shell "bash"
Set FontSize 18
Set Width 1200
Set Height 650
Set Padding 20
Set Theme "Dracula"
Set TypingSpeed 50ms
